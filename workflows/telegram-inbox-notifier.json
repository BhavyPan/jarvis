      },
      "id": "i1111111-1111-4111-8111-111111111111",
      "name": "Watch Telegram messages",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -380,
        0
      ],
      "webhookId": "jarvis-telegram-inbox",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_AFTER_IMPORT",
          "name": "Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const message = $json.message ?? $json;\nconst sender = [message.from?.first_name, message.from?.last_name].filter(Boolean).join(' ')\n  || message.from?.username\n  || 'Unknown sender';\nconst text = String(message.text ?? message.caption ?? '[non-text message]')\n  .replace(/[\\r\\n]+/g, ' ')\n  .slice(0, 240);\nreturn [{json:{\n  title: 'New Telegram message',\n  message: `${sender}: ${text}`,\n  level: 'info'\n}}];"
      },
      "id": "i2222222-2222-4222-8222-222222222222",
      "name": "Create private notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JARVIS_DESKTOP_BRIDGE_URL + '/notify' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "i3333333-3333-4333-8333-333333333333",
