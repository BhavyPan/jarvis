{
  "name": "Jarvis - Desktop Action Bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis/desktop-action",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d1111111-1111-4111-8111-111111111111",
      "name": "Desktop action webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -650,
        0
      ],
      "webhookId": "jarvis-desktop-action"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst suppliedKey = headers['x-jarvis-key'] ?? headers['X-Jarvis-Key'];\nconst action = String(body.action ?? '').trim().toLowerCase();\nconst allowedActions = ['open_app', 'open_url', 'take_screenshot', 'type_text', 'hotkey'];\nconst args = body.args && typeof body.args === 'object' && !Array.isArray(body.args) ? body.args : {};\nconst valid = suppliedKey === $env.JARVIS_API_KEY\n  && body.approved === true\n  && body.confirmation === 'CONTROL PC'\n  && allowedActions.includes(action);\nreturn [{json:{\n  authorized: valid,\n  action,\n  args,\n  requestId: crypto.randomUUID(),\n  error: valid ? undefined : 'Requires valid API key, approved:true, confirmation:CONTROL PC, and an allow-listed action.',\n  allowedActions,\n}}];"
      },
      "id": "d2222222-2222-4222-8222-222222222222",
      "name": "Validate desktop request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "d-if-auth",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "d3333333-3333-4333-8333-333333333333",
      "name": "Is approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -170,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JARVIS_DESKTOP_BRIDGE_URL + '/actions' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-jarvis-bridge-key",
              "value": "={{ $env.JARVIS_BRIDGE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ action: $json.action, args: $json.args, requestId: $json.requestId }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Request local desktop action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        90,
        -110
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, result: $json } }}",
        "options": {}
      },
      "id": "d5555555-5555-4555-8555-555555555555",
      "name": "Return bridge result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        340,
        -110
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: $json.error, allowedActions: $json.allowedActions } }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "d6666666-6666-4666-8666-666666666666",
      "name": "Return blocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        80,
        110
      ]
    }
  ],
