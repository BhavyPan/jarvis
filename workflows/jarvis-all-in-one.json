      "typeVersion": 2,
      "position": [
        -1040,
        -260
      ],
      "webhookId": "jarvis-all-in-one"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {}; const body = $json.body ?? {};\nconst text = String(body.text ?? body.command ?? '').trim().slice(0, 4000);\nreturn [{json:{authorized:(headers['x-jarvis-key'] ?? headers['X-Jarvis-Key']) === $env.JARVIS_API_KEY && Boolean(text),text,approved:body.approved === true,confirmation:String(body.confirmation ?? ''),error:'Provide x-jarvis-key and a text command.'}}];"
      },
      "id": "o002",
      "name": "Validate command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -820,
        -260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "auth",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "o003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -600,
        -260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $env.JARVIS_OPENAI_MODEL || 'gpt-4.1-mini', input: 'You are Jarvis. Return ONLY JSON: {action,reply,payload}. action is one of chat,send_email,send_telegram,desktop_action,web_research. Email payload: {to,subject,message}; Telegram: {chatId,text}; desktop: {action:open_app|open_url|take_screenshot|type_text|hotkey|speak,args:{}}; research: {mode:search|read,query?,url?}. Never claim action success. User: ' + $json.text }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "o004",
      "name": "Ask AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -370,
        -360
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Validate command').first().json;\nconst text = (Array.isArray($json.output) ? $json.output : []).flatMap(x => x.content ?? []).find(x => x.type === 'output_text')?.text ?? '';\nlet plan; try { plan = JSON.parse(text); } catch { plan = {action:'chat',reply:text || 'I could not understand that.',payload:{}}; }\nconst map = {send_email:'SEND EMAIL',send_telegram:'SEND MESSAGE',desktop_action:'CONTROL PC',web_research:'BROWSE WEB'};\nconst action = Object.hasOwn(map, plan.action) ? plan.action : 'chat';\nconst confirmation = map[action] ?? null;\nreturn [{json:{action,reply:String(plan.reply ?? 'Ready.'),payload:plan.payload && typeof plan.payload === 'object' ? plan.payload : {},requiredConfirmation:confirmation,requiresConfirmation:Boolean(confirmation),execute:Boolean(confirmation && original.approved && original.confirmation === confirmation)}}];"
      },
      "id": "o005",
      "name": "Validate AI plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
