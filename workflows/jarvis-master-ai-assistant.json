      ],
      "webhookId": "jarvis-master-assistant"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst suppliedKey = headers['x-jarvis-key'] ?? headers['X-Jarvis-Key'];\nconst text = String(body.text ?? body.command ?? '').trim().slice(0, 4000);\nconst authorized = suppliedKey === $env.JARVIS_API_KEY && text.length > 0;\nreturn [{json:{\n  authorized,\n  text,\n  approved: body.approved === true,\n  confirmation: String(body.confirmation ?? ''),\n  error: authorized ? undefined : 'Provide x-jarvis-key and a non-empty text command.'\n}}];"
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Validate user command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a-auth",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Is authorized?",
      "type": "n8n-nodes-base.if",
