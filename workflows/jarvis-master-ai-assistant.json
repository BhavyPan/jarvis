    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $env.JARVIS_OPENAI_MODEL || 'gpt-4.1-mini', input: 'You are Jarvis, a concise personal assistant. Return ONLY a JSON object with action, reply, payload. action must be chat, send_email, send_telegram, desktop_action, or web_research. For desktop_action payload is {action: open_app|open_url|take_screenshot|type_text|hotkey|speak, args:{...}}. For web_research payload is {mode: search|read, query?: string, url?: string}. For email payload is {to, subject, message}; for Telegram it is {chatId, text}. Never claim an action occurred; describe the planned action. User command: ' + $json.text }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Ask OpenAI to plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -140,
        -110
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Validate user command').first().json;\nconst output = Array.isArray($json.output) ? $json.output : [];\nconst text = output.flatMap(item => item.content ?? []).find(item => item.type === 'output_text')?.text ?? '';\nlet plan;\ntry { plan = JSON.parse(text); } catch { plan = { action: 'chat', reply: text || 'I could not prepare that request.', payload: {} }; }\nconst actionMap = {\n  send_email: { target: 'jarvis/send-email', confirmation: 'SEND EMAIL' },\n  send_telegram: { target: 'jarvis/send-telegram', confirmation: 'SEND MESSAGE' },\n  desktop_action: { target: 'jarvis/desktop-action', confirmation: 'CONTROL PC' },\n  web_research: { target: 'jarvis/web-research', confirmation: 'BROWSE WEB' },\n};\nconst action = actionMap[plan.action] ? plan.action : 'chat';\nconst required = actionMap[action]?.confirmation;\nconst execute = Boolean(required && source.approved && source.confirmation === required);\nconst payload = { ...(plan.payload && typeof plan.payload === 'object' ? plan.payload : {}), approved: true, confirmation: required };\nreturn [{json:{\n  ok: true,\n  reply: String(plan.reply ?? 'Ready.'),\n  action,\n  requiresConfirmation: Boolean(required),\n  requiredConfirmation: required ?? null,\n  execute,\n  target: actionMap[action]?.target ?? null,\n  forwardPayload: payload,\n}}];"
      },
