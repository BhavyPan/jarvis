    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst suppliedKey = headers['x-jarvis-key'] ?? headers['X-Jarvis-Key'];\nconst mode = String(body.mode ?? 'search').trim().toLowerCase();\nconst query = String(body.query ?? '').trim().slice(0, 500);\nconst url = String(body.url ?? '').trim();\nconst validUrl = !url || /^https:\\/\\//i.test(url);\nconst valid = suppliedKey === $env.JARVIS_API_KEY\n  && body.approved === true\n  && body.confirmation === 'BROWSE WEB'\n  && ['search', 'read'].includes(mode)\n  && validUrl\n  && (mode === 'search' ? query.length > 0 : url.length > 0);\nreturn [{json:{\n  authorized: valid,\n  mode,\n  query,\n  url,\n  requestId: `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`,\n  error: valid ? undefined : 'Requires valid API key, approved:true, confirmation:BROWSE WEB, and a search query or HTTPS URL.',\n}}];"
      },
      "id": "w2222222-2222-4222-8222-222222222222",
      "name": "Validate research request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
