      "position": [
        -640,
        0
      ],
      "webhookId": "jarvis-send-telegram"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst suppliedKey = headers['x-jarvis-key'] ?? headers['X-Jarvis-Key'];\nconst chatId = String(body.chatId ?? '').trim();\nconst text = String(body.text ?? '').trim();\nconst valid = suppliedKey === $env.JARVIS_API_KEY\n  && body.approved === true\n  && body.confirmation === 'SEND MESSAGE'\n  && /^-?\\d+$/.test(chatId)\n  && text.length > 0\n  && text.length <= 4096;\nreturn [{json:{\n  authorized: valid,\n  chatId,\n  text,\n  error: valid ? undefined : 'Requires valid API key, approved:true, confirmation:SEND MESSAGE, a numeric chatId, and text up to 4096 characters.'\n}}];"
      },
      "id": "t2222222-2222-4222-8222-222222222222",
      "name": "Validate approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "t-if-auth",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
