      "parameters": {
        "jsCode": "const fromValue = $json.from?.value?.[0];\nconst from = fromValue?.name\n  ? `${fromValue.name} <${fromValue.address}>`\n  : (fromValue?.address ?? $json.from?.text ?? $json.from ?? 'Unknown sender');\nconst subject = String($json.subject ?? '(no subject)').replace(/[\\r\\n]+/g, ' ').slice(0, 160);\nreturn [{json:{\n  title: 'New email',\n  message: `From: ${from}\\nSubject: ${subject}`,\n  level: 'info'\n}}];"
      },
