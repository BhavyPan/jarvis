      ],
      "webhookId": "jarvis-send-email"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst suppliedKey = headers['x-jarvis-key'] ?? headers['X-Jarvis-Key'];\nconst recipients = Array.isArray(body.to) ? body.to : String(body.to ?? '').split(',');\nconst cleanRecipients = recipients.map(value => String(value).trim()).filter(Boolean);\nconst isEmail = value => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value);\nconst valid = suppliedKey === $env.JARVIS_API_KEY\n  && body.approved === true\n  && body.confirmation === 'SEND EMAIL'\n  && cleanRecipients.length > 0\n  && cleanRecipients.every(isEmail)\n  && typeof body.subject === 'string' && body.subject.trim().length > 0\n  && typeof body.message === 'string' && body.message.trim().length > 0;\nreturn [{json:{\n  authorized: valid,\n  to: cleanRecipients.join(', '),\n  subject: String(body.subject ?? '').trim(),\n  message: String(body.message ?? '').trim(),\n  error: valid ? undefined : 'Requires valid API key, approved:true, confirmation:SEND EMAIL, recipient(s), subject, and message.'\n}}];"
      },
      "id": "e2222222-2222-4222-8222-222222222222",
      "name": "Validate approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
